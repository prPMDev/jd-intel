{
  "name": "jd-intel",
  "version": "0.8.2",
  "description": "Fetch and normalize job descriptions across seven major ATS (Greenhouse, Lever, Ashby, Workday, and more), for your AI assistant. No copy-paste.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jd-intel": "src/cli.js"
  },
  "files": [
    "src/",
    "registry/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "fetch": "node src/cli.js fetch",
    "search": "node src/cli.js search",
    "verify:registry": "node scripts/verify-registry.mjs",
    "sync:registry-pages": "node scripts/sync-pages-registry.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs",
    "smoke:mcpb": "node scripts/smoke-mcpb.mjs"
  },
  "keywords": [
    "jobs",
    "job-description",
    "ats",
    "greenhouse",
    "lever",
    "ashby",
    "mcp",
    "ai",
    "claude",
    "hiring",
    "careers",
    "model-context-protocol",
    "anthropic",
    "cursor",
    "windsurf",
    "ai-tools",
    "ai-assistant",
    "job-search",
    "applicant-tracking-system",
    "developer-tools",
    "nodejs"
  ],
  "author": "Prashant R",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prPMDev/jd-intel.git"
  },
  "bugs": {
    "url": "https://github.com/prPMDev/jd-intel/issues"
  },
  "homepage": "https://github.com/prPMDev/jd-intel#readme",
  "engines": {
    "node": ">=18"
  }
}
